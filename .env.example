# Database
DATABASE_URL="postgresql://app:change-me@localhost:5432/douyin_scripts?schema=public"
POSTGRES_DB="douyin_scripts"
POSTGRES_USER="app"
POSTGRES_PASSWORD=""

# Auth
# 至少 32 个随机字符；轮换时先撤销现有数据库会话。
SESSION_SECRET=""
# 32 个随机字节的 Base64，用于加密管理员 TOTP 密钥。
ADMIN_MFA_ENCRYPTION_KEY=""
# 至少 32 个随机字符；未设置时回退使用 SESSION_SECRET。
ADMIN_RECOVERY_CODE_PEPPER=""
# 仅首次创建 OWNER 时临时设置；目标文件必须不存在，脚本以 0600 独占创建。
BOOTSTRAP_ADMIN_OUTPUT_FILE=""

# App
NEXT_PUBLIC_APP_NAME=短视频脚本拆写优化网站
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 服务端运行时 CSRF Origin；生产填写公开 HTTPS Origin，不使用 NEXT_PUBLIC_ 前缀。
APP_ORIGIN=""
# 会话 Cookie 默认必须走 Secure；只有通过显式 ip-http 临时部署校验时才允许设为 false。
SESSION_COOKIE_SECURE=""
APP_DOMAIN=example.com
EDGEONE_ORIGIN_SECRET=""
# 仅无域名公网 IP 临时 staging 使用；显式设为 1 才允许 `deploy_mode=ip-http`。
STAGING_ALLOW_IP_HTTP=""
# 仅临时 ip-http staging 使用；显式设为 1 且 DOUYIN_PROVIDER=tikhub 时才允许启用真实 Provider。
STAGING_ENABLE_REAL_PROVIDERS=""

# Douyin transcript extraction provider
# 第一版只允许使用安全合规的抖音口播提取能力。
# Provider switch uses DOUYIN_PROVIDER: blocked | asr | tikhub.
# Production default should remain blocked until Provider terms/config are confirmed.
DOUYIN_PROVIDER="blocked"
TIKHUB_REQUEST_TIMEOUT_MS="15000"
TIKHUB_RETRY_DELAY_MS="500"

# ASR downstream provider: only accepts legal authorized media URLs.
# It does not resolve Douyin links.
# ASR_AUTHORIZED_MEDIA_URL is for local/internal testing only; production must get
# the matching authorized media URL from an upstream provider for the current Douyin URL.
ASR_API_KEY=""
ASR_API_BASE_URL=""
ASR_AUTHORIZED_MEDIA_URL=""

# Volcengine / Doubao ASR. Keep real values only in .env.local or deployment secrets.
# The endpoint/token names are intentionally server-only and must not use NEXT_PUBLIC_*.
VOLCENGINE_ASR_SUBMIT_ENDPOINT=""
VOLCENGINE_ASR_ENDPOINT=""
VOLCENGINE_ASR_QUERY_ENDPOINT=""
VOLCENGINE_ASR_API_KEY=""
VOLCENGINE_ASR_RESOURCE_ID=""
VOLCENGINE_APP_ID=""
VOLCENGINE_CLUSTER=""
VOLCENGINE_RESOURCE_ID=""
VOLCENGINE_ASR_MODEL=""
VOLCENGINE_ASR_REQUEST_TIMEOUT_MS="30000"
VOLCENGINE_ASR_QUERY_MAX_ATTEMPTS="30"
VOLCENGINE_ASR_QUERY_INTERVAL_MS="3000"
DOUBAO_ASR_ENDPOINT=""
DOUBAO_ASR_API_KEY=""

# TikHub test provider slot. Disabled unless DOUYIN_PROVIDER="tikhub" and both values are configured.
TIKHUB_API_KEY=""
TIKHUB_API_BASE_URL=""
TIKHUB_TEST_DOUYIN_URL=""
TIKHUB_TEST_DOUYIN_URLS=""

# AI provider
AI_PROVIDER=
AI_API_KEY=
AI_API_BASE_URL=
AI_MODEL=
DEEPSEEK_API_KEY=""
DEEPSEEK_API_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-v4-flash"

# Runtime limits
MAX_DOUYIN_URL_LENGTH=1000
AI_REQUEST_TIMEOUT_MS=60000
EXTRACTION_JOB_TIMEOUT_MS=300000
EXTRACTION_JOB_TTL_MS=900000
EXTRACTION_WORKER_CONCURRENCY=2
EXTRACTION_MAX_CONCURRENT_PER_USER=2
EXTRACTION_JOB_MAX_ATTEMPTS=3
EXTRACTION_WORKER_POLL_MS=1500
EXTRACTION_LOCK_TIMEOUT_MS=600000

# TikHub media relay: disabled until COS and a one-day lifecycle fallback are configured.
# The app actively deletes objects after confirmed ASR terminal states; COS lifecycle is the safety net.
MEDIA_RELAY_ENABLED=0
MEDIA_RELAY_CONCURRENCY=1
MEDIA_RELAY_TMP_DIR=/tmp/douyin-media-relay
MEDIA_RELAY_MAX_INPUT_BYTES=125829120
MEDIA_RELAY_MAX_OUTPUT_BYTES=26214400
MEDIA_RELAY_MAX_DURATION_SECONDS=180
MEDIA_RELAY_DOWNLOAD_TIMEOUT_MS=30000
MEDIA_RELAY_FFMPEG_TIMEOUT_MS=90000
MEDIA_RELAY_MAX_REDIRECTS=3
MEDIA_RELAY_OBJECT_PREFIX=asr-relay
MEDIA_RELAY_PUBLIC_BASE_URL=""

# Provider 单价（人民币），仅用于运营后台估算，最终账单以供应商为准。
COST_DEEPSEEK_INPUT_CNY_PER_MILLION=0
COST_DEEPSEEK_OUTPUT_CNY_PER_MILLION=0
COST_ASR_CNY_PER_HOUR=0
COST_TIKHUB_CNY_PER_REQUEST=0

# 备份：服务器只配置 age recipient 公钥；解密 identity 必须离线保管。
BACKUP_AGE_RECIPIENT=""
COS_BUCKET=""
COS_REGION="ap-hongkong"
COS_ENDPOINT="cos.ap-hongkong.myqcloud.com"
COS_ACCESS_KEY_ID=""
COS_SECRET_ACCESS_KEY=""
# Runtime COS credentials must be scoped to PutObject/DeleteObject on MEDIA_RELAY_OBJECT_PREFIX.
# Anonymous access may receive GetObject on that prefix only; never grant ListBucket.
