{
  "name": "script-workshop-core",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "worker": "tsx --tsconfig tsconfig.json worker/extraction-worker.ts",
    "worker:topics": "tsx --tsconfig tsconfig.json worker/topic-worker.ts",
    "worker:topics:check": "tsx --tsconfig tsconfig.json worker/topic-worker.ts --check",
    "worker:custom-scripts": "tsx --tsconfig tsconfig.json worker/custom-script-worker.ts",
    "worker:custom-scripts:check": "tsx --tsconfig tsconfig.json worker/custom-script-worker.ts --check",
    "worker:verify-functional": "tsx --tsconfig tsconfig.json worker/verify-functional.ts",
    "build": "next build",
    "lint": "eslint .",
    "test": "NODE_ENV=test NODE_OPTIONS=--require=./tests/server-only-shim.cjs node --import tsx --test tests/**/*.test.ts",
    "test:runtime-probe": "NODE_ENV=test NODE_OPTIONS=--require=./tests/server-only-shim.cjs node --import tsx --test --test-reporter=tap tests/topics/npm-test-runtime-probe.test.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:up": "docker compose -f compose.dev.yml up -d",
    "db:down": "docker compose -f compose.dev.yml down",
    "backup:preservation:oneshot": "sh deploy/backup/one-shot-preservation-backup.sh",
    "backup:restore:rehearsal": "sh deploy/backup/restore-rehearsal.sh",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "dotenv": "^17.4.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.20.0",
    "next": "^15.5.23",
    "ogl": "^1.0.11",
    "otpauth": "^9.5.1",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.9.0",
    "server-only": "^0.0.1",
    "three": "^0.184.0",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.10",
    "@types/node": "24.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/three": "^0.184.1",
    "eslint": "9.29.0",
    "eslint-config-next": "^15.5.23",
    "tailwindcss": "4.1.10",
    "typescript": "5.8.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.26"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "sharp": "0.35.3"
  }
}
